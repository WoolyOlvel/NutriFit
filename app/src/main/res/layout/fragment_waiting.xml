<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="handler"
            type="com.ascrib.nutrifit.ui.form.WaitingFragment" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_background">

        <!-- Gradient overlay for better text readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_overlay"
            android:alpha="0.3" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/_24sdp">

                <!-- Logo Section with pulse animation container -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:gravity="center">

                    <!-- Pulse Animation Circles (now positioned around the logo) -->
                    <View
                        android:id="@+id/pulseCircle1"
                        android:layout_width="@dimen/_140sdp"
                        android:layout_height="@dimen/_140sdp"
                        android:background="@drawable/pulse_circle"
                        android:alpha="0.0"
                        android:layout_centerInParent="true" />

                    <View
                        android:id="@+id/pulseCircle2"
                        android:layout_width="@dimen/_160sdp"
                        android:layout_height="@dimen/_160sdp"
                        android:background="@drawable/pulse_circle"
                        android:alpha="0.0"
                        android:layout_centerInParent="true" />

                    <!-- Animated Logo Container -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/logoCard"
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="@dimen/_120sdp"
                        app:cardCornerRadius="@dimen/_60sdp"
                        app:cardElevation="@dimen/_8sdp"
                        android:layout_centerInParent="true"
                        android:layout_marginBottom="@dimen/_24sdp">

                        <ImageView
                            android:id="@+id/logoImage"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/logo"
                            android:contentDescription="NutriFit Logo" />

                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

                <!-- Content Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="5"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Próximamente!"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_28sdp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NutriFit Planner Beta"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_20sdp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_16sdp" />

                    <!-- Description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Los servidores de Ascrib Company estarán disponibles muy pronto. ¡Prepárate para una experiencia increíble!"
                        android:textColor="@color/whiteGrey"
                        android:textSize="@dimen/_14sdp"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/_32sdp"
                        android:lineSpacingMultiplier="1.2" />

                    <!-- Countdown Container -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/_16sdp"
                        app:cardElevation="@dimen/_4sdp"
                        android:layout_marginBottom="@dimen/_24sdp"
                        app:cardBackgroundColor="@color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_20sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/_12sdp"
                                android:text="Tiempo restante"
                                android:textColor="@color/colorVariant"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />

                            <!-- Countdown Timer -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <!-- Days -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/_4sdp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvDays"
                                        android:layout_width="@dimen/_60sdp"
                                        android:layout_height="@dimen/_60sdp"
                                        android:background="@drawable/countdown_number_bg"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="00"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_20sdp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/_4sdp"
                                        android:text="Días"
                                        android:textColor="@color/grey"
                                        android:textSize="@dimen/_10sdp" />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_10sdp"
                                    android:text=":"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/_20sdp"
                                    android:textStyle="bold" />

                                <!-- Hours -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/_4sdp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvHours"
                                        android:layout_width="@dimen/_60sdp"
                                        android:layout_height="@dimen/_60sdp"
                                        android:background="@drawable/countdown_number_bg"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="00"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_20sdp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/_4sdp"
                                        android:text="Horas"
                                        android:textColor="@color/grey"
                                        android:textSize="@dimen/_10sdp" />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_10sdp"
                                    android:text=":"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/_20sdp"
                                    android:textStyle="bold" />

                                <!-- Minutes -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/_4sdp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvMinutes"
                                        android:layout_width="@dimen/_60sdp"
                                        android:layout_height="@dimen/_60sdp"
                                        android:background="@drawable/countdown_number_bg"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="00"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_20sdp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/_4sdp"
                                        android:text="Minutos"
                                        android:textColor="@color/grey"
                                        android:textSize="@dimen/_10sdp" />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_10sdp"
                                    android:text=":"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/_20sdp"
                                    android:textStyle="bold" />

                                <!-- Seconds -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/_4sdp"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvSeconds"
                                        android:layout_width="@dimen/_60sdp"
                                        android:layout_height="@dimen/_60sdp"
                                        android:background="@drawable/countdown_number_bg"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="00"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_20sdp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/_4sdp"
                                        android:text="Seg"
                                        android:textColor="@color/grey"
                                        android:textSize="@dimen/_10sdp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>



                </LinearLayout>

                <!-- Progress Bar - Fixed visibility -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:paddingHorizontal="@dimen/_20sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparando servidores..."
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp"
                        android:layout_marginBottom="@dimen/_8sdp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_8sdp"
                        android:progress="10"
                        android:progressTint="@color/colorSecondary"
                        android:progressBackgroundTint="@android:color/darker_gray"
                        android:indeterminate="false" />

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10% completado"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_gravity="end" />

                </LinearLayout>

                <!-- Footer Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.5"
                    android:orientation="vertical"
                    android:gravity="center|bottom">

                    <!-- Social Media or Contact Info -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/_16sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Síguenos para más actualizaciones"
                            android:textColor="@color/whiteGrey"
                            android:textSize="@dimen/_12sdp"
                            android:layout_marginBottom="@dimen/_12sdp" />

                        <!-- Social Media Icons -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <!-- Facebook Icon -->
                            <ImageView
                                android:id="@+id/facebook_icon"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/facebooklogo"
                                android:contentDescription="Facebook"
                                android:layout_marginHorizontal="@dimen/_8sdp"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="@{() -> handler.onSocialMediaClick(0)}"/>

                            <!-- Instagram Icon -->
                            <ImageView
                                android:id="@+id/instagram_icon"
                                android:layout_width="@dimen/_34sdp"
                                android:layout_height="@dimen/_34sdp"
                                android:src="@drawable/instagram"
                                android:contentDescription="Instagram"
                                android:layout_marginHorizontal="@dimen/_8sdp"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="@{() -> handler.onSocialMediaClick(1)}" />


                        </LinearLayout>

                    </LinearLayout>

                    <!-- Company Info -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Powered by Ascrib Company"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_8sdp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Floating particles animation background -->
        <View
            android:id="@+id/particle1"
            android:layout_width="@dimen/_6sdp"
            android:layout_height="@dimen/_6sdp"
            android:background="@drawable/particle_bg"
            android:alpha="0.6"
            android:layout_marginStart="@dimen/_50sdp"
            android:layout_marginTop="@dimen/_100sdp" />

        <View
            android:id="@+id/particle2"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_4sdp"
            android:background="@drawable/particle_bg"
            android:alpha="0.4"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_80sdp"
            android:layout_marginTop="@dimen/_150sdp" />

        <View
            android:id="@+id/particle3"
            android:layout_width="@dimen/_5sdp"
            android:layout_height="@dimen/_5sdp"
            android:background="@drawable/particle_bg"
            android:alpha="0.5"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_200sdp" />

    </RelativeLayout>

</layout>