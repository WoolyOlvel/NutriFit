<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_background">

        <!-- Gradient overlay for better text readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_overlay"
            android:alpha="0.3" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/_24sdp">

                <!-- Logo Section with pulse animation container -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:gravity="center">

                    <!-- Pulse Animation Circles -->
                    <View
                        android:id="@+id/pulseCircle1"
                        android:layout_width="@dimen/_140sdp"
                        android:layout_height="@dimen/_140sdp"
                        android:background="@drawable/pulse_circle"
                        android:alpha="0.0"
                        android:layout_centerInParent="true" />

                    <View
                        android:id="@+id/pulseCircle2"
                        android:layout_width="@dimen/_160sdp"
                        android:layout_height="@dimen/_160sdp"
                        android:background="@drawable/pulse_circle"
                        android:alpha="0.0"
                        android:layout_centerInParent="true" />

                    <!-- Animated Logo Container -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/logoCard"
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="@dimen/_120sdp"
                        app:cardCornerRadius="@dimen/_60sdp"
                        app:cardElevation="@dimen/_8sdp"
                        android:layout_centerInParent="true"
                        android:layout_marginBottom="@dimen/_24sdp">

                        <ImageView
                            android:id="@+id/logoImage"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/logo"
                            android:contentDescription="Beta Finalizada"
                            />

                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

                <!-- Content Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="5"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Beta Finalizada!"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_28sdp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NutriFit Planner Beta"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_20sdp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_16sdp" />

                    <!-- Description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="La beta test de NutriFit Planner ha finalizado exitosamente. Los servidores de Ascrib Company han sido detenidos. ¡Gracias por ser parte de esta experiencia!"
                        android:textColor="@color/whiteGrey"
                        android:textSize="@dimen/_14sdp"
                        android:textAlignment="center"
                        android:layout_marginBottom="@dimen/_32sdp"
                        android:lineSpacingMultiplier="1.2" />

                    <!-- Status Container (replaces Countdown) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/_16sdp"
                        app:cardElevation="@dimen/_4sdp"
                        android:layout_marginBottom="@dimen/_24sdp"
                        app:cardBackgroundColor="@color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_20sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/_12sdp"
                                android:text="Estado del Servidor"
                                android:textColor="@color/colorVariant"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />

                            <!-- Server Status -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🔴 OFFLINE"
                                    android:textColor="@color/red"
                                    android:textSize="@dimen/_18sdp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="@dimen/_8sdp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Servidores detenidos"
                                    android:textColor="@color/grey"
                                    android:textSize="@dimen/_12sdp" />

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Progress Bar Section (Hidden) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparando servidores..."
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp"
                        android:layout_marginBottom="@dimen/_8sdp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_8sdp"
                        android:progress="100"
                        android:progressTint="@color/colorSecondary"
                        android:progressBackgroundTint="@android:color/darker_gray"
                        android:indeterminate="false" />

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% completado"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_gravity="end" />

                </LinearLayout>

                <!-- Footer Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center|bottom">

                    <!-- Social Media or Contact Info -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/_16sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¡Gracias por participar en nuestra beta!"
                            android:textColor="@color/whiteGrey"
                            android:textSize="@dimen/_12sdp" />

                    </LinearLayout>

                    <!-- Company Info -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Powered by Ascrib Company"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_8sdp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Floating particles animation background -->
        <View
            android:id="@+id/particle1"
            android:layout_width="@dimen/_6sdp"
            android:layout_height="@dimen/_6sdp"
            android:background="@drawable/particle_bg"
            android:alpha="0.6"
            android:layout_marginStart="@dimen/_50sdp"
            android:layout_marginTop="@dimen/_100sdp" />

        <View
            android:id="@+id/particle2"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_4sdp"
            android:background="@drawable/particle_bg"
            android:alpha="0.4"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_80sdp"
            android:layout_marginTop="@dimen/_150sdp" />

        <View
            android:id="@+id/particle3"
            android:layout_width="@dimen/_5sdp"
            android:layout_height="@dimen/_5sdp"
            android:background="@drawable/particle_bg"
            android:alpha="0.5"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_200sdp" />

    </RelativeLayout>
</layout>