<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="handler"
            type="com.ascrib.nutrifit.ui.NotificationFragment" />
    </data>

    <RelativeLayout
        android:id="@+id/layout_nutri_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_button"
            android:background="@drawable/button_background"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_10sdp">

            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar_dark_arrow" />

            <!-- Sección de estado vacío -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/toolbar"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/section_spacing"
                android:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_marginBottom="@dimen/section_spacing"
                    android:contentDescription="Sin planes alimenticios"
                    android:src="@drawable/ic_documento_espera"
                    app:tint="@color/colorVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/inner_spacing"
                    android:gravity="center"
                    android:text="Plan Alimenticio No Disponible"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_size_h4"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Tu nutriólogo aún no ha subido tu plan alimenticio.\nPor favor espera, será publicado pronto."
                    android:textColor="@color/colorVariant"
                    android:textSize="@dimen/text_size_h6"
                    android:lineSpacingExtra="@dimen/_2sdp" />

                <!-- Indicador de carga animado -->
                <ProgressBar
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/colorPrimary" />

            </LinearLayout>

            <!-- RecyclerView para mostrar los planes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_patient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/toolbar"
                android:padding="@dimen/section_spacing"
                android:visibility="gone" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layout_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/section_spacing"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/listAlimen"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_h6" />

        </LinearLayout>

    </RelativeLayout>

</layout>